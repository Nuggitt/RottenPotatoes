# LF overalt, også på Windows: filerne køres i Linux-containere (Makefile, shell, SQL).
* text=auto eol=lf

*.sln        text eol=lf
*.csproj     text eol=lf
*.cs         text eol=lf
*.json       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.md         text eol=lf
*.sql        text eol=lf
*.cypher     text eol=lf
*.sh         text eol=lf
Makefile     text eol=lf
Dockerfile*  text eol=lf
.env*        text eol=lf

# Windows-scripts skal have CRLF
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.ps1        text eol=crlf

# Binære filer
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
*.gz   binary
