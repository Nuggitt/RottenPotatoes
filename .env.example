# Kopiér til .env:  cp .env.example .env   (virker i PowerShell, bash og zsh)
# .env er git-ignoreret. Skift alle passwords. Undgå ; " ' @ : / i passwords,
# da de indsættes direkte i connection strings.

# MySQL (databasen hedder altid rotten_potatoes, som i jeres dump)
MYSQL_ROOT_PASSWORD=skift_mig_root
MYSQL_USER=rp_app
MYSQL_PASSWORD=skift_mig_app

# MongoDB
MONGO_ROOT_USERNAME=rp_admin
MONGO_ROOT_PASSWORD=skift_mig_mongo
MONGO_DATABASE=RottenPotatoes

# Neo4j (brugernavn er altid neo4j; password mindst 8 tegn)
NEO4J_PASSWORD=skift_mig_neo4j

# Porte på værten (bundet til 127.0.0.1). Skift hvis de allerede er i brug.
MYSQL_HOST_PORT=3306
MONGO_HOST_PORT=27017
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
API_HOST_PORT=8080

# Bruger i dev-containeren, så filer i projektmappen ejes af dig på Linux.
# Find dine værdier med `id -u` og `id -g`. Windows/macOS: lad stå på 1000.
# Rootless Docker eller Podman: sæt begge til 0.
DEV_UID=1000
DEV_GID=1000
